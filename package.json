{
  "name": "@rosado-io/streakr",
  "version": "1.2.0",
  "description": "A framework-agnostic presentation layer for contribution and activity calendars.",
  "type": "module",
  "module": "./dist/streakr.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/streakr.js"
    },
    "./styles.css": "./dist/streakr.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:dead-code": "knip",
    "check:package": "publint && attw --pack . --profile esm-only --entrypoints . --ignore-rules cjs-resolves-to-esm",
    "format": "prettier --write 'src/**/*.ts' 'demo/**/*.ts' '*.config.ts' 'eslint.config.js'",
    "format:check": "prettier --check 'src/**/*.ts' 'demo/**/*.ts' '*.config.ts' 'eslint.config.js'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "contribution",
    "heatmap",
    "streak",
    "data-visualization",
    "calendar",
    "svg",
    "git"
  ],
  "author": "Eduardo Rosado",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosado-io/streakr.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@10.12.2",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.0",
    "knip": "^6.27.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
